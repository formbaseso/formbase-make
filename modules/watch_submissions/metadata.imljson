{
    "name": "watchSubmissions",
    "label": "Watch Public Link Submissions",
    "description": "Triggers when a customer submits the form through its public link, or abandons a partial submission. Event type is submission.completed, submission.updated, or submission.abandoned. Answers arrive in data.answers keyed by field key and readable text in data.display. A completed request fires Watch Requests instead, never this trigger.",
    "type": "instant_trigger",
    "connection": "formbase",
    "webhook": "submission_webhook"
}
