{
    "name": "watchSubmissions",
    "label": "Watch Submissions",
    "description": "Triggers when a form receives a submission or an abandoned partial submission. Event type is submission.completed, submission.updated, or submission.abandoned; answers arrive in data.answers keyed by field key, with readable text in data.display.",
    "type": "instant_trigger",
    "connection": "formbase",
    "webhook": "submission_webhook"
}
