{
    "name": "watchPublicLinkSubmissions",
    "label": "Watch Public Link Submissions",
    "description": "Triggers when a respondent submits the form through its public link, updates that submission later, or abandons it. Event type is submission.completed, submission.updated or submission.abandoned. Answers arrive in data.answers keyed by field key, readable text in data.display. A completed request fires Watch Requests instead.",
    "type": "instant_trigger",
    "connection": "formbase",
    "webhook": "submission_webhook"
}
