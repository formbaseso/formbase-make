{
    "url": "/api/v1",
    "method": "POST",
    "body": {
        "method": "webhooks.create",
        "params": {
            "formId": "{{parameters.formId}}",
            "targetUrl": "{{webhook.url}}",
            "provider": "make",
            "eventType": "{{parameters.eventType}}",
            "idleWindow": "{{ifempty(parameters.idleWindow, undefined)}}"
        }
    },
    "response": {
        "data": {
            "subscriptionId": "{{body.data.subscriptionId}}"
        }
    }
}
