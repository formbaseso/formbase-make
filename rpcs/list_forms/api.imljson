{
    "url": "/",
    "method": "POST",
    "body": {
        "method": "forms.list",
        "params": {
            "workspaceId": "{{connection.workspaceId}}",
            "limit": 100
        }
    },
    "response": {
        "limit": 300,
        "iterate": "{{body.data.items}}",
        "output": {
            "label": "{{item.name}}",
            "value": "{{item.id}}"
        }
    },
    "pagination": {
        "condition": "{{body.data.hasMore == true && body.data.nextCursor != null}}",
        "body": {
            "method": "forms.list",
            "params": {
                "workspaceId": "{{connection.workspaceId}}",
                "limit": 100,
                "cursor": "{{body.data.nextCursor}}"
            }
        }
    }
}
